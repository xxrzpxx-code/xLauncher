{
  "name": "xlauncher",
  "productName": "xLauncher",
  "version": "1.0.0",
  "description": "Launcher Minecrafta: Fabric, Forge i Vanilla, mody z Modrinth, konto Microsoft lub offline",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^4.0.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.xlauncher.app",
    "productName": "xLauncher",
    "files": [
      "src/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "xLauncher",
      "uninstallDisplayName": "xLauncher"
    },
    "artifactName": "xLauncher-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "TWOJ_LOGIN_GITHUB",
      "repo": "xlauncher",
      "releaseType": "release"
    }
  },
  "author": {
    "name": "xLauncher"
  },
  "copyright": "Copyright (c) 2026 xLauncher"
}